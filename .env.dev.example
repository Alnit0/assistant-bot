# Settings for the dev bot only (python main.py --dev). Copy to .env.dev.
# Whatever is set here is used instead of the same name in .env; everything
# else still comes from .env. Without this file, --dev is the live bot's own
# account on the dev database, as before.

# The dev bot's own token (Discord Developer Portal: a second application).
# With one, it is the dev bot: it runs beside live (a lock and a log of its
# own), the self-test uses it and never stops live, and it takes NO channel
# from .env: only the channels named below are its own. A channel left empty
# here is one it does not have.
DISCORD_TOKEN=
# The dev bot's own account id. A start with --dev exits, touching nothing, unless its
# token logs in as this account (so it can never run as live by mistake)
BOT_USER_ID=
# The dev bot's nickname in the server, taken on every start. During a self-test it is
# "<name> · testing", and the plain name again after. Empty: left as it is
BOT_NAME=

# Its name in replies and its nickname
ASSISTANT_NAME=

# The channels it works in. Give it channels of its own (a test server, or
# test channels in the same one): the self-test's are #selftest-inbox,
# #selftest-log, #selftest-hub and the forum #selftest-bugs
# (right-click a channel, Copy Channel ID). They are found by these ids only, whatever
# they are called, and never made: python -m selftest --channels checks they are there
INBOX_CHANNEL_ID=
BOT_LOG_CHANNEL_ID=
HUB_CHANNEL_ID=
ARCHIVE_CHANNEL_ID=
DEV_CHANNEL_ID=
BUGS_CHANNEL_ID=
COMMANDS_CHANNEL_ID=
