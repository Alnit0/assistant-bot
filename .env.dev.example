# Settings for the dev bot only (python main.py --dev). Copy to .env.dev.
# Whatever is set here is used instead of the same name in .env; everything
# else still comes from .env. Without this file, --dev is the live bot's own
# account on the dev database, as before.

# The dev bot's own token (Discord Developer Portal: a second application)
DISCORD_TOKEN=

# Its name in replies and its nickname
ASSISTANT_NAME=

# The channels it works in. Give it channels of its own (a test server, or
# test channels in the same one): two bots in one channel both answer
INBOX_CHANNEL_ID=
BOT_LOG_CHANNEL_ID=
HUB_CHANNEL_ID=
ARCHIVE_CHANNEL_ID=
DEV_CHANNEL_ID=
BUGS_CHANNEL_ID=
COMMANDS_CHANNEL_ID=
