DISCORD_TOKEN=your-discord-bot-token
OWNER_ID=your-discord-user-id
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-haiku-4-5

# What the assistant calls itself (default Hive)
ASSISTANT_NAME=Hive

# Skills to load, comma-separated (e.g. builtin). Leave empty to load all
ENABLED_SKILLS=

# Seconds a "done" confirmation stays before deleting itself (default 5)
CONFIRMATION_SECONDS=5

# Seconds of quiet before a reaction (📦, 🗑️) is acted on; remove it sooner to cancel
REACTION_DEBOUNCE=30

# Pomodoro: true starts each phase by itself; false waits for you to press Start
POMO_AUTO_CONTINUE=false

# Channels
INBOX_CHANNEL_ID=your-inbox-channel-id
BOT_LOG_CHANNEL_ID=your-bot-log-channel-id
REMINDERS_CHANNEL_ID=your-reminders-channel-id
GYM_CHANNEL_ID=your-gym-channel-id
ADMIN_CHANNEL_ID=your-admin-channel-id
DOCUMENTS_CHANNEL_ID=your-documents-channel-id
ARCHIVE_CHANNEL_ID=your-archive-channel-id
# Scratch channel for manual testing (docs/QA-RUN.md)
DEV_CHANNEL_ID=your-dev-channel-id