DISCORD_TOKEN=your-discord-bot-token
# The bot's own account id (right-click the bot in Discord, Copy User ID). Every start asks
# Discord who its token is and exits, touching nothing, unless it is this account
BOT_USER_ID=your-bot-user-id
# The bot's nickname in the server. It takes this name on every start. Empty: left as it is
BOT_NAME=
OWNER_ID=your-discord-user-id
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-haiku-4-5

# What the assistant calls itself (default Hive)
ASSISTANT_NAME=Hive

# Tasks to load, comma-separated (e.g. builtin). Leave empty to load all.
# (The old name, ENABLED_SKILLS, is still read if this one is empty)
ENABLED_TASKS=

# Seconds a "done" confirmation stays before deleting itself (default 5)
CONFIRMATION_SECONDS=5

# true (the default) leaves confirmations and other self-deleting notes in the
# channel, so you can see what the bot did; false tidies them away as before
KEEP_CONFIRMATIONS=true
# Pill reminders (a message at each dose's time). Off unless set to true
REMINDERS_ENABLED=false
# To-dos, reminders you set yourself, and personal routines: each off unless set (not loaded at all when off)
TODOS_ENABLED=false
# The diary: your words about your day, a mood, a streak, one gentle ask at 9 pm if nothing is written.
# Its words are kept in the database only. DIARY_MOOD=false keeps no mood (no buttons; the ask asks for words)
DIARY_ENABLED=false
DIARY_MOOD=true
# The smart inbox: several things in one message, or a photo, screenshot, PDF or CSV in #inbox or a direct
# message, sorted onto one card (core/smartinbox.py). Off: each thing is read as before, and files are not read
SMART_INBOX=false
# Plan my day: "plan my day", "plan tomorrow", "replan" put your to-dos into the free time around what is fixed
# (core/planning.py, tasks/plan). Off: not loaded
PLAN_MY_DAY=false
# Birthdays, in reminders (with NUDGES_ENABLED): a quiet line 14 days before, a post 3 days before with your gift
# notes, and on the day; each a yearly all-day event in the Bot calendar when it can be written. Off: not loaded
BIRTHDAYS_ENABLED=false
# The daily read: one article a day (AI usage, programming, tech news), picked at 5:30 am from the feeds in
# tasks/reading/feeds.json, with a short TL;DR; its card in the hub, 👍 and 👎 to shape it
READING_ENABLED=false
NUDGES_ENABLED=false
HABITS_ENABLED=false
# How personal routines are shown: b (the Today card, and a card a routine from its time until it is done) or a (one card for them all)
ROUTINES_LAYOUT=b
# The calendar, read only (off unless true), and its secret iCal address from Google Calendar's
# settings: in live's .env only, never in a doc, a log or a commit
CALENDAR_ENABLED=false
CALENDAR_ICS_URL=
# Which calendars to read, comma apart: ics (the link above), google:<calendar id or a setting's name>,
# e.g. ics,google:CALENDAR_BOT_ID. Unset: ics. docs/GOOGLE-SETUP.md says how to add one
CALENDAR_READ=
# The Google service account's key file (outside the repo) and the calendars' ids
GOOGLE_SA_KEY_PATH=
CALENDAR_MAIN_ID=
CALENDAR_BOT_ID=
# Add, move and delete events in words, in the Bot calendar only (read with Google too)
CALENDAR_WRITE=false
# The Today card: the day in time order (to-dos, personal routines, reminders as notes) under the pills card. Off unless true
TODAY_CARD=false
# The briefing: one card a day in the hub saying what today holds, posted before the
# checklist and kept up to date in place; and "brief me". Off unless true
BRIEFING_ENABLED=false
# The day's progress at the top of the briefing: a dot a thing to do and the count
# ("☀️ Today ●●●●●○○ 5/7") and a small line a task ("💊 2/3"), kept up to date as
# things are done. Off unless true
DAY_PROGRESS=false
# Questions about your day, answered from what is kept and never guessed: "what's left
# today?", "how did I go yesterday?", "this week?" (needs the briefing), and "will it
# rain?", "what's the weather this afternoon?" (needs the weather). Off unless true
DAY_QUESTIONS=false
# Until this time a day with every dose taken says so on the status line ("💊 all 5 taken");
# after it the line shows when the morning routine runs ("🌅 6am"). 24-hour clock
STATUS_DONE_UNTIL=20:00
# Live's memory use is said (status line, a bug) once it is over this many MB, or has
# kept growing for a day. It is in `dev status` and in the log every hour
MEMORY_LIMIT_MB=300
# The most the self-test may spend on real requests to Claude in a month (NZ dollars).
# Over it, runs use recorded answers only, and live's status line says so
SELFTEST_MONTHLY_LIMIT_NZD=3.50
# Weather in the briefing: today's low and high, rain and wind, from Open-Meteo (free, no
# key), fetched at 5:50 am and refreshed every 3 hours until 8:00 pm. On unless set to false.
# Where it is for: your latitude and longitude, as decimal numbers
WEATHER_ENABLED=true
WEATHER_LAT=
WEATHER_LON=
# Costs are shown in NZ$ and recorded in US$. The rate is fetched once a day (no key
# needed); until one has been fetched, this is the rate
USD_TO_NZD=1.70
# Quiet hours, for pings only (the status line is silent): from-to on the 24-hour clock.
# In them only a pill reminder pings; the rest waits for the briefing
QUIET_HOURS=22:00-07:00
# Quiet hours in force. Off, nothing is held back and everything notifies as it always did.
# On, what falls in them is posted without a sound, never pushed, and listed in the
# morning's briefing as held back overnight until it is dealt with. A pill reminder
# always gets through, with its sound
QUIET_HOURS_ENABLED=false
# Alerts on your phone through ntfy, as well as (or instead of) Discord: which kind goes
# where is the table in core/notify.py. What is pushed is neutral (never a pill's name),
# and tapping it opens the Discord message. Needs NTFY_BOT_TOPIC
NOTIFY_NTFY=false
# The bot's own ntfy topic: not the one Claude Code's notifications use. A secret
NTFY_BOT_TOPIC=
# Direct messages: with this on you can talk to the bot in a direct message as in #inbox.
# Only you; its replies there are silent, and their first line never names a pill
DMS_ENABLED=false
# The weekly pills summary: on Sunday at 7:00 pm the week (a line a day, the count, the
# streak) is posted in the hub. `my schedule` moves it
WEEKLY_SUMMARY=false
# With WEEKLY_SUMMARY on: the Sunday summary is the week of everything (pills, to-dos,
# personal routines, next week's calendar), one card, in place of the pills-only one
WEEKLY_ALL=false
# The nightly self-test: at 3:00 am the dev bot runs the stages changed since each last
# passed (everything on Sundays), with live left running. Its summary goes in the
# self-test's log channel; your phone is pinged only if a step fails. Needs a dev bot
NIGHTLY_SELFTEST=false
# The tidy that keeps the hub clean: what you say there and the reply go 2 minutes after
# the reply (or with the card), nothing of a past day stays, pinned is kept, and what is
# removed is written to data/exports first. Off unless true
HUB_TIDY=false
# Cards drawn as Components V2 (docs/DESIGN.md). Off: every card looks as it always has
CARDS_V2=false
# Which round of the design (docs/DESIGN-LOG.md), with CARDS_V2 on: 3 the type scale, 1 the look before it
DESIGN_ROUND=3

# What a day's requests to Claude may cost (NZ dollars) before you are told, once.
# Nothing is stopped. 0 switches it off
DAILY_SPEND_LIMIT_NZD=1.00

# Seconds of quiet before a reaction (📦, 🗑️) is acted on; remove it sooner to cancel
REACTION_DEBOUNCE=30

# Pomodoro: true starts each phase by itself; false waits for you to press Start
POMO_AUTO_CONTINUE=false

# Channels
INBOX_CHANNEL_ID=your-inbox-channel-id
BOT_LOG_CHANNEL_ID=your-bot-log-channel-id
REMINDERS_CHANNEL_ID=your-reminders-channel-id
GYM_CHANNEL_ID=your-gym-channel-id
ADMIN_CHANNEL_ID=your-admin-channel-id
DOCUMENTS_CHANNEL_ID=your-documents-channel-id
ARCHIVE_CHANNEL_ID=your-archive-channel-id
# Scratch channel for manual testing (docs/QA-RUN.md)
DEV_CHANNEL_ID=your-dev-channel-id
# A forum channel: every bug reported with 🐞 or `bug` gets a post here
BUGS_CHANNEL_ID=your-bugs-forum-channel-id
# The hub: the daily pills checklist and its prompts are posted here
HUB_CHANNEL_ID=your-hub-channel-id
# #commands: the bot lists what it can do here and keeps it up to date at start-up.
# Make it read-only for yourself; the bot needs Send Messages and Manage Messages there
COMMANDS_CHANNEL_ID=your-commands-channel-id
