DISCORD_TOKEN=your-discord-bot-token
# The bot's own account id (right-click the bot in Discord, Copy User ID). Every start asks
# Discord who its token is and exits, touching nothing, unless it is this account
BOT_USER_ID=your-bot-user-id
# The bot's nickname in the server. It takes this name on every start. Empty: left as it is
BOT_NAME=
OWNER_ID=your-discord-user-id
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-haiku-4-5

# What the assistant calls itself (default Hive)
ASSISTANT_NAME=Hive

# Tasks to load, comma-separated (e.g. builtin). Leave empty to load all.
# (The old name, ENABLED_SKILLS, is still read if this one is empty)
ENABLED_TASKS=

# Seconds a "done" confirmation stays before deleting itself (default 5)
CONFIRMATION_SECONDS=5

# true (the default) leaves confirmations and other self-deleting notes in the
# channel, so you can see what the bot did; false tidies them away as before
KEEP_CONFIRMATIONS=true
# Pill reminders (a message at each dose's time). Off unless set to true
REMINDERS_ENABLED=false
# The briefing: one card a day in the hub saying what today holds, posted before the
# checklist and kept up to date in place; and "brief me". Off unless true
BRIEFING_ENABLED=false
# The tidy that keeps the hub clean: what you say there and the reply go 2 minutes after
# the reply (or with the card), nothing of a past day stays, pinned is kept, and what is
# removed is written to data/exports first. Off unless true
HUB_TIDY=false
# Cards drawn as Components V2 (docs/DESIGN.md). Off: every card looks as it always has
CARDS_V2=false

# What a day's requests to Claude may cost (US dollars) before #bot-log says so, once.
# Nothing is stopped. 0 switches the note off
DAILY_SPEND_LIMIT=0.50

# Seconds of quiet before a reaction (📦, 🗑️) is acted on; remove it sooner to cancel
REACTION_DEBOUNCE=30

# Pomodoro: true starts each phase by itself; false waits for you to press Start
POMO_AUTO_CONTINUE=false

# Channels
INBOX_CHANNEL_ID=your-inbox-channel-id
BOT_LOG_CHANNEL_ID=your-bot-log-channel-id
REMINDERS_CHANNEL_ID=your-reminders-channel-id
GYM_CHANNEL_ID=your-gym-channel-id
ADMIN_CHANNEL_ID=your-admin-channel-id
DOCUMENTS_CHANNEL_ID=your-documents-channel-id
ARCHIVE_CHANNEL_ID=your-archive-channel-id
# Scratch channel for manual testing (docs/QA-RUN.md)
DEV_CHANNEL_ID=your-dev-channel-id
# A forum channel: every bug reported with 🐞 or `bug` gets a post here
BUGS_CHANNEL_ID=your-bugs-forum-channel-id
# The hub: the daily pills checklist and its prompts are posted here
HUB_CHANNEL_ID=your-hub-channel-id
# #commands: the bot lists what it can do here and keeps it up to date at start-up.
# Make it read-only for yourself; the bot needs Send Messages and Manage Messages there
COMMANDS_CHANNEL_ID=your-commands-channel-id
